{
  "manifest_version": 3,
  "name": "FormNimora — AI Form Filler",
  "version": "1.4.0",
  "description": "Điền Google Forms với AI và quy tắc. Chế độ Điền biểu mẫu tự chuyển phần và gửi một lần sau xác nhận.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "activeTab", "scripting", "sidePanel"],
  "host_permissions": ["https://docs.google.com/forms/*"],
  "content_scripts": [{
    "matches": ["https://docs.google.com/forms/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "action": { "default_icon": { "16": "icons/formnimora-16.png", "32": "icons/formnimora-32.png", "48": "icons/formnimora-48.png", "128": "icons/formnimora-128.png" } },
  "side_panel": { "default_path": "popup.html" },
  "icons": { "16": "icons/formnimora-16.png", "32": "icons/formnimora-32.png", "48": "icons/formnimora-48.png", "128": "icons/formnimora-128.png" },
  "options_page": "options.html",
  "background": { "service_worker": "background.js", "type": "module" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'" }
}
